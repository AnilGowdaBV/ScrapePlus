APP_NAME=LiSeSca People Search Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./database/lisesca.db
API_PREFIX=/api

# Browser Execution Settings
# Visible browser allows manual user authentication and CAPTCHA observation
BROWSER_HEADLESS=false
BROWSER_USER_DATA_DIR=./database/browser_profile
# Optional: Connect to an existing browser running on remote debugging port (e.g., http://localhost:9222)
# BROWSER_CDP_URL=http://localhost:9222
BROWSER_TIMEOUT_MS=30000